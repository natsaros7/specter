{
  "kit_version": "0.1.0",
  "code_globs": ["orders-api/src/*", "fulfilment-worker/src/*", "catalog-cache/src/*", "shop-common/src/*", "web/src/*", "deploy/*"],
  "ignore_globs": ["*/node_modules/*", "*/target/*", "*.md"],
  "spec_sync": "warn",
  "spec_threshold_loc": 15,
  "req_id_pattern": "REQ-[A-Z0-9]+-[0-9]+",
  "upstream_req_pattern": "CON-REQ-[0-9]{3}",
  "required_sections": {"requirements": [], "design": []}
}
