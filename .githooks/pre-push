#!/bin/sh
# Local guardrail, not a platform one: `git push --no-verify` skips it. Enable once per clone:
#   git config core.hooksPath .githooks
if [ "${SPECTER_SKIP_GATES:-}" = 1 ]; then
  echo "pre-push: SPECTER_SKIP_GATES=1, gates SKIPPED" >&2
  exit 0
fi
cd "$(git rev-parse --show-toplevel)" || exit 1
unset SELFTEST_ONLY  # an inherited filter would make G3 a partial run
if [ -n "$(git status --porcelain)" ]; then
  echo "pre-push: uncommitted or untracked changes; the gates would test files you are not pushing. Commit or stash, or skip on purpose with SPECTER_SKIP_GATES=1" >&2
  exit 1
fi
if docker info >/dev/null 2>&1; then
  exec sh tests/gates.sh --docker
fi
echo "pre-push: no Docker, running gates on the host (slow on scanned machines)" >&2
exec sh tests/gates.sh
